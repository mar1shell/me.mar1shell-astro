---
import { projects } from "../../data/projects";
import { site } from "../../data/site";
import { sections } from "../../data/sections";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import Arrow from "../../components/ui/Arrow.astro";
import ProjectGallery from "../../components/ProjectGallery/ProjectGallery";
---

<section id="work" class="section" aria-labelledby="work-title">
  <SectionHeading section={sections.projects} />
  <div data-reveal><ProjectGallery projects={projects} client:visible /></div>
  <div class="section-end">
    <span class="editorial-note">Always something in the works.</span><a
      class="text-link"
      href={site.socials[0].href}
      target="_blank"
      rel="noopener noreferrer">More on GitHub<Arrow /></a
    >
  </div>
</section>
