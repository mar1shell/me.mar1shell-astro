---
import { site, hero } from "../../data/site";
import { motion } from "../../data/motion";
import Arrow from "../../components/ui/Arrow.astro";
import NetworkField from "../../components/NetworkField/NetworkField.astro";
import SocialButtons from "../../components/SocialButtons/SocialButtons.astro";
---

<section class="hero section-grid" aria-labelledby="hero-title">
  <div class="hero-top hero-enter">
    <p class="editorial-note">{hero.eyebrow}</p>
    <p class="eyebrow hero-location">
      <span class="status-dot"></span>{site.location}
    </p>
  </div>
  <NetworkField />
  <div class="hero-intro">
    <div class="hero-identity">
      <p
        class="hero-role eyebrow hero-enter"
        style={`--enter-delay: ${motion.stagger}ms`}
      >
        {site.role}
      </p>
      <h1 id="hero-title">
        <span
          class="hero-name-line"
          style={`--enter-delay: ${motion.stagger}ms`}
          ><span>{site.firstName}</span></span
        >
        <span
          class="hero-name-line"
          style={`--enter-delay: ${motion.stagger * 2}ms`}
          ><span>{site.lastName}<span class="accent">.</span></span></span
        >
      </h1>
      <div class="hero-enter" style={`--enter-delay: ${motion.stagger * 3}ms`}>
        <SocialButtons links={site.socials} />
      </div>
    </div>
    <figure
      class="hero-portrait hero-enter"
      style={`--enter-delay: ${motion.stagger}ms`}
    >
      <div class="hero-photo">
        <img
          src={site.portrait}
          alt={site.name}
          width="480"
          height="560"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>
        <span class="editorial-note">{hero.portraitCaption}</span><span
          class="mono">@{site.username}</span
        >
      </figcaption>
    </figure>
  </div>
  <div
    class="hero-bottom hero-enter"
    style={`--enter-delay: ${motion.stagger * 4}ms`}
  >
    <p>{hero.introduction}</p>
    <div class="hero-actions">
      <a class="button button-primary" href={hero.primaryAction.href}
        >{hero.primaryAction.label}<span class="button-icon"><Arrow /></span></a
      >
      {
        site.bookingUrl ? (
          <a
            class="button button-secondary"
            href={site.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {hero.meetingLabel}
            <span class="button-icon">
              <Arrow />
            </span>
          </a>
        ) : (
          <a class="text-link" href={hero.secondaryAction.href}>
            {hero.secondaryAction.label}
            <Arrow />
          </a>
        )
      }
    </div>
  </div>
  <div
    class="hero-foot hero-enter"
    style={`--enter-delay: ${motion.stagger * 5}ms`}
  >
    <ul class="hero-disciplines mono">
      {hero.disciplines.map((item) => <li>{item}</li>)}
    </ul>
    <a href="#about" class="scroll-link mono"
      >Scroll to explore <Arrow direction="down" /></a
    >
  </div>
</section>
