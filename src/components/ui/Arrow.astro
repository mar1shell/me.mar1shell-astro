---
interface Props {
  direction?: "up-right" | "right" | "down";
  class?: string;
}
const { direction = "up-right", class: className = "" } = Astro.props;
---

<svg
  class:list={["arrow-icon", className]}
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden="true"
>
  {
    direction === "up-right" ? (
      <path d="M6 18 18 6M6 6h12v12" />
    ) : direction === "right" ? (
      <path d="M4 12h16m-6-6 6 6-6 6" />
    ) : (
      <path d="M12 4v16m-6-6 6 6 6-6" />
    )
  }
</svg>
