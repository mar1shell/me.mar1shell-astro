---
import { site } from "../../data/site";
import AnalyticsConsent from "../AnalyticsConsent/AnalyticsConsent";
---

<footer class="site-footer page-width">
  <div class="footer-top">
    <a href="#top" class="footer-wordmark" aria-label="Back to top"
      >{site.username}<span class="accent">.</span></a
    ><a class="back-top mono" href="#top"
      >Back to top <span aria-hidden="true">↑</span></a
    >
  </div><div class="footer-bottom mono">
    <span>© {new Date().getFullYear()} {site.name}</span><span
      >Built with curiosity. Made with Astro & React.</span
    ><span>{site.location}</span>
  </div>
  <AnalyticsConsent client:load />
</footer>

<style>
  .site-footer :global(.analytics-preference) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    padding-block: 24px;
    color: var(--color-muted);
    font-size: 12px;
  }
  .site-footer :global(.analytics-preference p) {
    max-width: 640px;
    line-height: 1.7;
  }
  .site-footer :global(.analytics-preference button) {
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 12px 16px;
    color: var(--color-text);
    background: var(--color-surface);
    cursor: pointer;
  }
</style>
