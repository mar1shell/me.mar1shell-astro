---
import { site } from "../../data/site";
---

<footer class="site-footer page-width">
  <div class="footer-top">
    <a href="#top" class="footer-wordmark" aria-label="Back to top"
      >{site.username}<span class="accent">.</span></a
    ><a class="back-top mono" href="#top"
      >Back to top <span aria-hidden="true">↑</span></a
    >
  </div><div class="footer-bottom mono">
    <span>© {new Date().getFullYear()} {site.name}</span><span
      >Built with curiosity. Made with Astro & React.</span
    ><span>{site.location}</span>
  </div>
</footer>
